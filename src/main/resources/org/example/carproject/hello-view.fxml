<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.carproject.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <TextField fx:id="licensePlateNumber" />
   <TextField fx:id="name" />
   <Spinner fx:id="year" />
    <Button onAction="#addButton" text="Add!" />
   <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0">
     <columns>
       <TableColumn fx:id="tablelicensePlateNumbe" prefWidth="75.0" text="licensePlateNumber" />
       <TableColumn fx:id="tablename" prefWidth="75.0" text="name" />
         <TableColumn fx:id="tableyear" prefWidth="75.0" text="year" />
     </columns>
   </TableView>
</VBox>
